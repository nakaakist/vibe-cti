{
  "general": {
    "configs_folder": "/opt/janus/etc/janus",
    "plugins_folder": "/opt/janus/lib/janus/plugins",
    "transports_folder": "/opt/janus/lib/janus/transports",
    "events_folder": "/opt/janus/lib/janus/events",
    "loggers_folder": "/opt/janus/lib/janus/loggers",
    "log_to_stdout": true,
    "debug_level": 4,
    "debug_timestamps": true,
    "debug_colors": false,
    "daemonize": false,
    "pid_file": "/var/run/janus.pid",
    "interface": "0.0.0.0",
    "api_secret": "janusapisecret",
    "token_auth": false,
    "admin_secret": "janusadminsecret",
    "server_name": "ViBE CTI Janus Server",
    "session_timeout": 60,
    "reclaim_session_timeout": 0,
    "candidates_timeout": 45,
    "no_multicast": false,
    "ice_lite": false,
    "ice_tcp": false,
    "full_trickle": false,
    "ice_nomination": "regular",
    "ice_keepalive_conncheck": false,
    "ice_consent_freshness": false,
    "hangup_on_failed": false,
    "keepalive_interval": 120,
    "static_event_loops": 0,
    "opaqueid_in_api": false,
    "hide_dependencies": false,
    "protected_folders": [
      "/bin",
      "/boot",
      "/dev",
      "/etc",
      "/initrd",
      "/lib",
      "/lib32",
      "/lib64",
      "/proc",
      "/sbin",
      "/sys",
      "/usr",
      "/var"
    ]
  },
  "nat": {
    "stun_server": "stun.l.google.com",
    "stun_port": 19302,
    "nice_debug": false,
    "ice_lite": false,
    "ice_tcp": false,
    "ice_nomination": "regular",
    "ice_keepalive_conncheck": false,
    "turn_server": "coturn",
    "turn_port": 3478,
    "turn_type": "udp",
    "turn_user": "vibe",
    "turn_pwd": "vibe123"
  },
  "media": {
    "ipv6": false,
    "ipv6_linklocal": false,
    "min_nack_queue": 200,
    "rtp_port_range": "10000-10100",
    "dtls_mtu": 1200,
    "no_media_timer": 1,
    "slowlink_threshold": 4,
    "twcc_period": 100,
    "dtls_timeout": 500,
    "nack_optimizations": false
  },
  "transports": {
    "disable": ""
  },
  "plugins": {
    "disable": ""
  },
  "events": {
    "broadcast": true,
    "disable": ""
  }
}